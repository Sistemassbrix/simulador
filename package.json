{
  "name": "simulador-modern",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p apps/api/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node apps/api/dist/main.js",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx apps/api/src/main.ts",
    "db:migrate": "prisma migrate deploy",
    "data:import": "tsx tools/import-data.ts",
    "data:verify": "tsx tools/verify-data.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.0.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "bcryptjs": "3.0.3",
    "bootstrap": "5.3.2",
    "chart.js": "4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "html-react-parser": "5.2.7",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sweetalert2": "11.26.25",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.17",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
